{% extends "default/module.html.jinja2" %}

{% block nav_footer %}
<footer>
<select id="version-selector">
    <option value="latest">latest</option>
</select>
<script>
    var split_at = "/docs/";
    if (window.location.href.includes('github.io')) {
        split_at = "github.io/type_enforced/";
    }
    var base_url = window.location.href.split(split_at)[0] + split_at;

    // Set the currently selected option to be equivalent to that of the url version.
    var version = 'latest';
    var version_path = window.location.href.split(split_at)[1];
    if (version_path && version_path.includes('/')) {
        var potential_version = version_path.split('/')[0];
        if (potential_version.match(/^\d+\.\d+\.\d+$/)) {
            version = potential_version;
        }
    }

    var selector = document.getElementById('version-selector');

    function populateVersions(versions) {
        selector.innerHTML = '<option value="latest">latest</option>';
        versions.forEach(function(v) {
            var opt = document.createElement('option');
            opt.value = v;
            opt.textContent = v;
            selector.appendChild(opt);
        });
        selector.value = version;
    }

    // Load versions.js via script tag (works seamlessly across file://, localhost, and GitHub Pages with zero CORS restrictions)
    var script = document.createElement('script');
    script.src = base_url + 'versions.js';
    script.onload = function() {
        if (window.DOC_VERSIONS) {
            populateVersions(window.DOC_VERSIONS);
        }
    };
    script.onerror = function() {
        // Fallback to fetch versions.json if versions.js is not loaded
        fetch(base_url + 'versions.json')
            .then(function(r) { return r.json(); })
            .then(populateVersions)
            .catch(function(e) { console.warn('Could not load doc versions:', e); });
    };
    document.head.appendChild(script);

    selector.onchange = function() {
        var selectedVersion = this.value;
        var new_url = (selectedVersion === 'latest') ? '' : selectedVersion + '/';
        var url = window.location.href.split(split_at)[0] + split_at + new_url + 'index.html';
        window.location.href = url;
    };
</script>
</footer>
{% endblock %}